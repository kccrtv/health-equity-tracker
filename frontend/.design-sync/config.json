{
  "projectId": "99925523-f08d-46df-9106-de9f871db392",
  "shape": "package",
  "pkg": "health-equity-tracker-frontend",
  "globalName": "HET",
  "srcDir": "src/styles/HetComponents",
  "tsconfig": "tsconfig.json",
  "buildCmd": "npm run build && mkdir -p .design-sync/dist-css && cp build/assets/index-*.css .design-sync/dist-css/site.css",
  "cssEntry": ".design-sync/dist-css/site.css",
  "tokensGlob": "src/styles/tokens/*.css",
  "componentSrcMap": {
    "HetLocationSearch": null,
    "VirtualizedListbox": null,
    "HetTopicDemographics": null,
    "HetDesktopToolbar": null,
    "HetMobileToolbar": null,
    "HetAppBar": null
  },
  "extraEntries": ["@mui/material/styles", "react-router", "./.design-sync/muiThemeRef.ts"],
  "provider": {
    "component": "StyledEngineProvider",
    "props": { "enableCssLayer": true },
    "inner": {
      "component": "ThemeProvider",
      "props": { "theme": { "$ref": "muiTheme" }, "defaultMode": "light" },
      "inner": {
        "component": "MemoryRouter",
        "props": {}
      }
    }
  },
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "HetDivider": { "cardMode": "column" },
    "HetLazyLoader": { "cardMode": "column" },
    "HetOnThisPageMenu": { "cardMode": "single", "primaryStory": "Default" }
  },
  "libOverrides": {
    "source-kit.mjs": "(1) componentSrcMap:null must also exclude a component's file from the synth-entry bundle, not just the discovered list — several components transitively hit Vite-only import.meta.glob calls that crash the whole IIFE. (2) the synth entry used bare `export * from <path>`, which never re-exports `default` — most HetComponents use `export default Foo`, so 44/49 landed as undefined on window.HET despite passing the render check (floor-card fallback masked it). Both explained in NOTES.md"
  },
  "extraFonts": [
    "node_modules/@fontsource-variable/inter/index.css",
    "node_modules/@fontsource-variable/dm-sans/index.css",
    "node_modules/@fontsource/roboto/latin-300.css",
    "node_modules/@fontsource/roboto/latin-400.css",
    "node_modules/@fontsource/roboto/latin-500.css",
    "node_modules/@fontsource/roboto/latin-700.css",
    "node_modules/@fontsource/roboto-condensed/latin-400.css",
    "node_modules/@fontsource/taviraj/200.css",
    "node_modules/@fontsource/taviraj/300.css",
    "node_modules/@fontsource/taviraj/400.css",
    "node_modules/@fontsource/taviraj/500.css"
  ]
}
